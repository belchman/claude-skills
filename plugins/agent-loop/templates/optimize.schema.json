{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-loop optimize proposal (al-state optimize payload)",
  "type": "object",
  "required": ["spec_gaps", "verify_gaps", "planner_guidance", "canon"],
  "additionalProperties": false,
  "properties": {
    "spec_gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verify_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cmd", "reason"],
        "additionalProperties": false,
        "properties": {
          "cmd": { "type": "string", "minLength": 1 },
          "expect": { "enum": ["exit0"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "planner_guidance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "canon": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
