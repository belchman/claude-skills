{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-loop state.json",
  "type": "object",
  "required": ["goal_id", "iteration", "done_means", "last_verdict", "progress_hash", "stall_count", "paused_by_stall", "stall_report", "run_in_progress", "interrupted_at", "context_tokens_last_iter", "plan", "history"],
  "additionalProperties": false,
  "properties": {
    "goal_id": { "type": "string" },
    "iteration": { "type": "integer", "minimum": 0 },
    "done_means": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "last_verdict": {
      "type": ["object", "null"],
      "required": ["pass", "failures", "at"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "boolean" },
        "failures": { "type": "array", "items": { "type": "string" } },
        "at": { "type": "string" }
      }
    },
    "progress_hash": { "type": ["string", "null"] },
    "stall_count": { "type": "integer", "minimum": 0 },
    "paused_by_stall": { "type": "boolean" },
    "stall_report": { "type": ["string", "null"] },
    "run_in_progress": { "type": "boolean" },
    "interrupted_at": { "type": ["string", "null"] },
    "context_tokens_last_iter": { "type": ["integer", "null"] },
    "tokens_total": { "type": ["integer", "null"] },
    "plan": {
      "type": "object",
      "required": ["status", "tasks", "assumptions", "proposed_at", "approved_at", "approved_by", "rejected_reason"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["none", "awaiting-human", "approved"] },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task"],
            "additionalProperties": false,
            "properties": {
              "task": { "type": "string" },
              "files_hint": { "type": ["string", "null"] },
              "parallel": { "type": "boolean" },
              "kind": { "enum": ["test", "impl", "docs", "chore"] }
            }
          }
        },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "proposed_at": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] },
        "approved_by": { "type": ["string", "null"] },
        "rejected_reason": { "type": ["string", "null"] }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["iter", "planned", "verdict", "hash"],
        "additionalProperties": false,
        "properties": {
          "iter": { "type": "integer" },
          "planned": { "type": "array", "items": { "type": "string" } },
          "verdict": { "enum": ["pass", "fail"] },
          "hash": { "type": ["string", "null"] },
          "at": { "type": "string" }
        }
      }
    }
  }
}
