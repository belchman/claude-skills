/* ================= grid render ================= */
function fmt(n){ return (n && n.toLocaleString) ? n.toLocaleString() : String(n); }
function baseName(p){
  var parts = String(p||"").split("/").filter(Boolean);
  return parts.length ? parts[parts.length-1] : String(p||"?");
}
function stamp(txt, cls){ return '<span class="stamp '+cls+'">'+esc(txt)+'</span>'; }

function cardEl(e){
  var flags = e.flags || [];
  var div = document.createElement("div");
  div.className = "card cham brk" + (e.needs_human ? " needs-human" : "");
  var g = e.goal || {};
  var status = g.status || "none";
  var dm = e.done_means || {};
  var converged = (dm.total > 0) && (dm.done === dm.total) && status === "active";
  var ribbon = "";
  if (flags.indexOf("breaker-open") >= 0)           ribbon = '<div class="ribbon red">◈ BREAKER</div>';
  else if (flags.indexOf("stalled") >= 0)           ribbon = '<div class="ribbon red">◈ STALLED</div>';
  else if (flags.indexOf("awaiting-approval") >= 0) ribbon = '<div class="ribbon">◆ GATE HOLD</div>';
  else if (converged) ribbon = '<div class="ribbon" style="color:var(--aqua);border-color:var(--aqua)">✓ CONVERGED — close-out awaits</div>';
  var tok = e.tokens_total == null ? 0 : e.tokens_total;
  var budget = g.budget_tokens || 0;
  var arch = e.archive || {};
  var planCls = e.plan_status === "awaiting-human" ? "amber"
              : e.plan_status === "approved" ? "aqua" : "";
  var html = ribbon;
  html += '<div class="rname">'+esc(baseName(e.repo))+'</div>';
  html += '<div class="rpath">'+esc(e.repo||"")+'</div>';
  html += '<div class="gline"><span class="gid">'+esc(g.id||"no active goal")+'</span>'+
          stamp(status, status==="active" ? "aqua" : status==="done" ? "dim" : "amber")+
          (dm.total ? ' <small style="color:'+(converged?"var(--aqua)":"var(--dim)")+'">'+
            esc(dm.done)+'/'+esc(dm.total)+'</small>' : "")+
          '</div>';
  html += '<div class="meters">'+
    '<div class="m"><span class="k">iteration</span><span class="v">'+
      esc(e.iteration==null?"—":e.iteration)+' <small>/ '+esc(g.max_iterations||"∞")+'</small></span></div>'+
    '<div class="m"><span class="k">tokens</span><span class="v'+
      (budget && tok >= budget ? ' red' : '')+'">'+esc(fmt(tok))+
      (budget ? ' <small>/ '+esc(fmt(budget))+'</small>' : ' <small>unbudgeted</small>')+
      '</span></div>'+
    '</div>';
  html += '<div class="lamps">'+
    '<span><span class="lamp '+planCls+'"></span>plan '+esc(e.plan_status||"none")+'</span>'+
    '<span><span class="lamp'+(e.paused_by_stall ? ' red' : '')+'"></span>stall</span>'+
    '<span><span class="lamp'+(e.consecutive_errors >= 3 ? ' red' : '')+'"></span>breaker</span>'+
    '<span><span class="lamp'+(e.lease ? ' aqua' : '')+'"></span>lease</span>'+
    '</div>';
  html += '<div class="archline">'+esc(arch.goals||0)+' goals archived · '+
          esc(fmt(arch.tokens||0))+' tokens lifetime</div>';
  div.innerHTML = html;
  div.addEventListener("click", function(){
    location.href = "/?repo=" + encodeURIComponent(e.repo);
  });
  return div;
}

function render(fleet){
  fleet = Array.isArray(fleet) ? fleet : [];
  var needsHuman = 0;
  fleet.forEach(function(x){ if (x.needs_human) needsHuman++; });
  document.title = (needsHuman ? "◆ "+needsHuman+" — " : "") + "agent-loop fleet";
  setFavicon(needsHuman ? "#ffb454" : "#5ff2dc");
  $("fleetchip").textContent = fleet.length + (fleet.length === 1 ? " repo" : " repos");
  var grid = $("fleetgrid");
  grid.innerHTML = "";
  if (!fleet.length){
    grid.innerHTML = '<div class="empty">NO REPOS REGISTERED — run a loop anywhere and it appears here</div>';
    return;
  }
  fleet.slice().sort(function(a, b){
    if (!!a.needs_human !== !!b.needs_human) return a.needs_human ? -1 : 1;
    var an = baseName(a.repo).toLowerCase(), bn = baseName(b.repo).toLowerCase();
    return an < bn ? -1 : an > bn ? 1 : 0;
  }).forEach(function(e){ grid.appendChild(cardEl(e)); });
}

/* ================= live stream ================= */
setFavicon("#5ff2dc");
var es = new EventSource("/events");
es.addEventListener("fleet", function(ev){
  try { render(JSON.parse(ev.data)); } catch(err){}
});
es.onopen = function(){ $("conn").innerHTML = '<span class="led aqua"></span>LIVE'; };
es.onerror = function(){ $("conn").innerHTML = '<span class="led red"></span>RELINK'; };
fetch("/api/fleet").then(function(r){ return r.json(); }).then(render).catch(function(){});
</script>
</body>
</html>
"""


def make_fleet_handler(registry_path, allow_actions):
    """Fleet-mode handler — a SEPARATE class, deliberately not a parameterized
    rewrite of make_handler(): single-repo behavior stays byte-identical, so
    a little duplication here is the safe trade."""

    class FleetHandler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *args):
            if not QUIET:
                BaseHTTPRequestHandler.log_message(self, fmt, *args)

        # -- helpers -------------------------------------------------------------
        def send_json(self, code, obj):
            body = json.dumps(obj).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def read_body_json(self):
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                length = 0
            if length <= 0:
                return {}
            try:
                return json.loads(self.rfile.read(length).decode("utf-8", "replace"))
            except ValueError:
                return {}

        # -- GET ----------------------------------------------------------------
        def do_GET(self):
            split = urlsplit(self.path)
            path = split.path
            qs = parse_qs(split.query)
            repo_raw = (qs.get("repo") or [None])[0]
            repo = None
            if repo_raw is not None:
                rp = os.path.realpath(repo_raw)
                if rp in read_registry(registry_path):
                    repo = rp
            if path == "/":
                # registered ?repo= -> the single-repo console (drill-down);
                # bare / unregistered -> the fleet grid home screen.
                page = DASHBOARD_HTML if repo is not None else FLEET_HTML
                body = page.replace(
                    "__ALLOW_ACTIONS__", json.dumps(allow_actions)).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            elif path == "/api/fleet":
                self.send_json(200, [slim_snapshot(r)
                                     for r in read_registry(registry_path)])
            elif path == "/api/state":
                if repo is None:
                    self.send_json(404, {"error": "unknown or unregistered repo"})
                else:
                    self.send_json(200, snapshot(repo, allow_actions))
            elif path == "/events":
                if repo_raw is None:
                    self.serve_fleet_events()
                elif repo is None:
                    self.send_json(404, {"error": "unknown or unregistered repo"})
                else:
                    self.serve_repo_events(repo)
            elif path == "/api/archive":
                if repo is None:
                    self.send_json(404, {"error": "unknown or unregistered repo"})
                    return
                goal_id = (qs.get("goal") or [None])[0]
                if goal_id is None:
                    self.send_json(200, archive_list(repo))
                else:
                    detail = archive_detail(repo, goal_id)
                    if detail is None:
                        self.send_json(404, {"error": "no such archived goal"})
                    else:
                        self.send_json(200, detail)
            else:
                self.send_json(404, {"error": "not found"})

        # -- SSE ----------------------------------------------------------------
        def sse(self, event, data):
            chunk = ""
            if event:
                chunk += "event: %s\n" % event
            for line in data.split("\n"):
                chunk += "data: %s\n" % line
            chunk += "\n"
            self.wfile.write(chunk.encode("utf-8"))
            self.wfile.flush()

        def start_sse(self):
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "close")
            self.end_headers()

        def serve_fleet_events(self):
            """`event: fleet` with the slim array on change, plus heartbeats."""
            self.start_sse()
            try:
                last = None
                last_hb = time.time()
                while True:
                    snap = json.dumps([slim_snapshot(r)
                                       for r in read_registry(registry_path)],
                                      sort_keys=True)
                    if snap != last:
                        last = snap
                        self.sse("fleet", snap)
                    now = time.time()
                    if now - last_hb >= HEARTBEAT_SECS:
                        last_hb = now
                        self.wfile.write(b": heartbeat\n\n")
                        self.wfile.flush()
                    time.sleep(POLL_SECS)
            except (BrokenPipeError, ConnectionResetError):
                pass  # client went away — normal for a dashboard tab closing

        def serve_repo_events(self, repo):
            """Single-repo drill-down: same replay/follow semantics as
            make_handler's /events, addressed by ?repo=."""
            audit_path = os.path.join(al_dir(repo), "audit.jsonl")
            self.start_sse()
            try:
                offset = self.replay_journal(audit_path)
                last_snap = None
                last_hb = time.time()
                buf = b""
                while True:
                    try:
                        size = os.path.getsize(audit_path)
                    except OSError:
                        size = 0
                    if size < offset:
                        offset, buf = 0, b""
                    if size > offset:
                        with open(audit_path, "rb") as f:
                            f.seek(offset)
                            buf += f.read(size - offset)
                        offset = size
                        while b"\n" in buf:
                            line, buf = buf.split(b"\n", 1)
                            line = line.decode("utf-8", "replace").rstrip("\r")
                            if line.strip():
                                self.sse("journal", line)
                    snap = json.dumps(snapshot(repo, allow_actions), sort_keys=True)
                    if snap != last_snap:
                        last_snap = snap
                        self.sse("state", snap)
                    now = time.time()
                    if now - last_hb >= HEARTBEAT_SECS:
                        last_hb = now
                        self.wfile.write(b": heartbeat\n\n")
                        self.wfile.flush()
                    time.sleep(POLL_SECS)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def replay_journal(self, audit_path):
            """Emit every existing audit.jsonl line VERBATIM; return byte offset."""
            try:
                with open(audit_path, "rb") as f:
                    raw = f.read()
            except OSError:
                return 0
            offset = len(raw)
            if raw and not raw.endswith(b"\n"):  # hold a partial trailing line
                cut = raw.rfind(b"\n") + 1
                raw, offset = raw[:cut], cut
            for bline in raw.split(b"\n"):
                line = bline.decode("utf-8", "replace").rstrip("\r")
                if line.strip():
                    self.sse("journal", line)
            return offset

        # -- POST ----------------------------------------------------------------
        def do_POST(self):
            # one CSRF rule, both modes: JSON Content-Type + a local Host header
            ctype = self.headers.get("Content-Type") or ""
            if "application/json" not in ctype:
                self.send_json(415, {"error": "Content-Type must be application/json"})
                return
            host = (self.headers.get("Host") or "").partition(":")[0]
            if host not in ("127.0.0.1", "localhost"):
                self.send_json(403, {"error": "requests must address 127.0.0.1 or localhost"})
                return
            path = self.path.split("?", 1)[0]
            if path not in ("/api/approve", "/api/reject"):
                self.send_json(404, {"error": "not found"})
                return
            body = self.read_body_json()
            repo_val = body.get("repo")
            if not isinstance(repo_val, str) or not repo_val.strip():
                self.send_json(400, {"error": "fleet actions require a \"repo\" in the JSON body"})
                return
            repo = os.path.realpath(repo_val)
            if repo not in read_registry(registry_path):
                self.send_json(404, {"error": "repo is not a registered fleet member"})
                return
            if not allow_actions:
                self.send_json(403, {"error": "actions disabled — restart al-watch with --allow-actions"})
                return
            if path == "/api/approve":
                ok, out = run_al_state(repo, ["plan-approve"])
            else:
                reason = body.get("reason")
                if not isinstance(reason, str) or not reason.strip():
                    self.send_json(400, {"error": "reject requires a non-empty \"reason\" in the JSON body"})
                    return
                ok, out = run_al_state(repo, ["plan-reject", reason])
            self.send_json(200 if ok else 500, {"ok": ok, "output": out})

    return FleetHandler


# --- main -------------------------------------------------------------------------

def main(argv=None):
    ap = argparse.ArgumentParser(prog="al-watch",
                                 description="Local real-time dashboard for one "
                                             "agent-loop repo, or the whole fleet "
                                             "(bare invocation).")
    ap.add_argument("repo", nargs="?", default=None,
                    help="repo root for single-repo mode; omit for fleet mode "
                         "($AL_FLEET_REGISTRY or ~/.claude/agent-loop/fleet.list)")
    ap.add_argument("--port", type=int, default=DEFAULT_PORT,
                    help="port (default %d; 0 = OS-assigned)" % DEFAULT_PORT)
    ap.add_argument("--allow-actions", action="store_true",
                    help="enable POST /api/approve and /api/reject")
    args = ap.parse_args(argv)

    if args.repo is not None:
        repo = os.path.abspath(args.repo)
        handler = make_handler(repo, args.allow_actions)
        watching = "watching %s" % repo
    else:
        registry = default_registry()
        handler = make_fleet_handler(registry, args.allow_actions)
        watching = "watching fleet (registry %s)" % registry
    server = ThreadingHTTPServer(("127.0.0.1", args.port), handler)
    server.daemon_threads = True
    port = server.server_address[1]
    mode = "actions ENABLED" if args.allow_actions else "read-only"
    print("al-watch: %s — %s at http://127.0.0.1:%d" % (mode, watching, port),
          flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
