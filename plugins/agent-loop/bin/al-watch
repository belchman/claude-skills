#!/usr/bin/env python3
"""al-watch — local real-time dashboard for an agent-loop repo, or the fleet.

Usage: al-watch [<repo>] [--port N] [--allow-actions]

Stdlib only. Binds 127.0.0.1 ONLY.

Single-repo mode (repo positional supplied) serves:
  GET  /            embedded HTML dashboard (dark monospace)
  GET  /api/state   JSON snapshot of .claude/agent-loop/ files
  GET  /events      SSE: verbatim audit.jsonl replay + live follow,
                    state snapshots on change, heartbeat comments
  POST /api/approve plan-approve via al-state   (requires --allow-actions)
  POST /api/reject  plan-reject '<reason>'      (requires --allow-actions)

Fleet mode (bare invocation, no repo arg) reads the machine-wide registry
($AL_FLEET_REGISTRY or ~/.claude/agent-loop/fleet.list — an append-only file
of repo roots written by al-state init/lease-acquire and al-loop.sh; the
server NEVER writes it) and serves:
  GET  /                    fleet page
  GET  /api/fleet           slim per-repo snapshots (flags + needs_human,
                            al-fleet's conditions; archive stats)
  GET  /events              SSE: `event: fleet` slim array on change + heartbeats
  GET  /events?repo=<path>  single-repo SSE drill-down (registry members only)
  GET  /api/state?repo=<path>   single-repo snapshot (registry members only)
  GET  /api/archive?repo=<path>[&goal=<id>]  archived-goal list / detail
  POST /api/approve|/api/reject with {"repo": ...} addressed to a registry member

POSTs (both modes) require Content-Type: application/json and a
127.0.0.1/localhost Host header. Read-only by default: without
--allow-actions the POST endpoints answer 403. Actions run <bindir>/al-state
with AL_ACTOR="<user>@al-watch" so the journal attributes them to the
dashboard, never to a bare shell user.
"""
import argparse
import getpass
import json
import os
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit

BIN_DIR = os.path.dirname(os.path.abspath(__file__))
DEFAULT_PORT = 4177
POLL_SECS = 1.0
HEARTBEAT_SECS = 15.0
QUIET = not os.environ.get("AL_WATCH_DEBUG")


# --- snapshot assembly ---------------------------------------------------------

def al_dir(repo):
    return os.path.join(repo, ".claude", "agent-loop")


def read_json(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def read_text(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def read_int(path):
    txt = read_text(path)
    if txt is None:
        return 0
    try:
        return int(txt.strip() or 0)
    except ValueError:
        return 0


def snapshot(repo, allow_actions):
    """Assemble the /api/state JSON. Missing files -> nulls, never a 500."""
    d = al_dir(repo)
    return {
        "repo": repo,
        "allow_actions": allow_actions,
        "goal": read_json(os.path.join(d, "goal.json")),
        "state": read_json(os.path.join(d, "state.json")),
        "goal_md": read_text(os.path.join(d, "GOAL.md")),
        "memory_md": read_text(os.path.join(d, "MEMORY.md")),
        "policy": read_json(os.path.join(d, "policy.json")),
        "consecutive_errors": read_int(os.path.join(d, "logs", "consecutive_errors")),
        "lease": read_json(os.path.join(d, ".lease", "owner.json")),
    }


# --- fleet mode: registry + slim snapshots --------------------------------------

def default_registry():
    return os.environ.get("AL_FLEET_REGISTRY") or os.path.join(
        os.path.expanduser("~"), ".claude", "agent-loop", "fleet.list")


def breaker_threshold():
    """Circuit-breaker threshold — the same AL_LOOP_MAX_ERRORS knob the
    scheduler (al-loop.sh) and al-fleet honor, so all three tools agree on
    when a loop reads breaker-open."""
    try:
        v = int(os.environ.get("AL_LOOP_MAX_ERRORS", "3"))
    except (TypeError, ValueError):
        return 3
    return v if v > 0 else 3


def read_registry(path):
    """Registry lines -> ordered, deduped, realpath'd, existing dirs only.
    Strictly read-only: dead paths are pruned from VIEW, never from the file."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    seen, out = set(), []
    for ln in lines:
        ln = ln.strip()
        if not ln:
            continue
        rp = os.path.realpath(ln)
        if rp in seen:
            continue
        seen.add(rp)
        if os.path.isdir(rp):
            out.append(rp)
    return out


# lifetime archive stats are cached per repo, keyed on the archive dir's
# mtime — archived goals only change when a goal is closed out, so the
# per-poll fleet snapshot never re-walks archives that didn't move.
_ARCHIVE_STATS_CACHE = {}


def archive_stats(repo):
    arch = os.path.join(al_dir(repo), "archive")
    try:
        mtime = os.stat(arch).st_mtime
    except OSError:
        return {"goals": 0, "tokens": 0}
    cached = _ARCHIVE_STATS_CACHE.get(repo)
    if cached and cached[0] == mtime:
        return cached[1]
    goals, tokens = 0, 0
    try:
        names = os.listdir(arch)
    except OSError:
        names = []
    for name in names:
        d = os.path.join(arch, name)
        if not os.path.isdir(d):
            continue
        goals += 1
        st = read_json(os.path.join(d, "state.json")) or {}
        tt = st.get("tokens_total")
        if isinstance(tt, (int, float)):
            tokens += int(tt)
    stats = {"goals": goals, "tokens": tokens}
    _ARCHIVE_STATS_CACHE[repo] = (mtime, stats)
    return stats


def slim_snapshot(repo):
    """One fleet card's worth of data. Deliberately SLIM: no goal_md /
    memory_md / policy bodies — drill-down uses the single-repo endpoints.
    flags + needs_human reproduce al-fleet's conditions exactly."""
    d = al_dir(repo)
    goal = read_json(os.path.join(d, "goal.json")) or {}
    state = read_json(os.path.join(d, "state.json")) or {}
    plan = state.get("plan") or {}
    lv = state.get("last_verdict")
    errs = read_int(os.path.join(d, "logs", "consecutive_errors"))
    it, mx = state.get("iteration"), goal.get("max_iterations")
    tt, bg = state.get("tokens_total"), goal.get("budget_tokens")
    flags = []
    if plan.get("status") == "awaiting-human":
        flags.append("awaiting-approval")
    if state.get("paused_by_stall") is True:
        flags.append("stalled")
    if isinstance(it, int) and isinstance(mx, int) and mx > 0 and it >= mx:
        flags.append("at-ceiling")
    if isinstance(tt, (int, float)) and isinstance(bg, (int, float)) \
            and bg > 0 and tt >= bg:
        flags.append("over-budget")
    if errs >= breaker_threshold():
        flags.append("breaker-open")
    dm = state.get("done_means") or {}
    return {
        "repo": repo,
        "goal": {"id": goal.get("id"), "status": goal.get("status"),
                 "max_iterations": mx, "budget_tokens": bg},
        "done_means": {"done": sum(1 for v in dm.values() if v), "total": len(dm)},
        "iteration": it,
        "plan_status": plan.get("status"),
        "plan_tasks": len(plan.get("tasks") or []),
        "plan_assumptions": len(plan.get("assumptions") or []),
        "tokens_total": tt,
        "paused_by_stall": state.get("paused_by_stall") is True,
        "last_verdict_pass": lv.get("pass") if isinstance(lv, dict) else None,
        "consecutive_errors": errs,
        "lease": os.path.exists(os.path.join(d, ".lease", "owner.json")),
        "flags": flags,
        "needs_human": bool(flags),
        "archive": archive_stats(repo),
    }


def archive_list(repo):
    """[{goal, tokens_total, done_means summary, has_goal_md}] per archive dir."""
    arch = os.path.join(al_dir(repo), "archive")
    out = []
    try:
        names = sorted(os.listdir(arch))
    except OSError:
        names = []
    for name in names:
        d = os.path.join(arch, name)
        if not os.path.isdir(d):
            continue
        st = read_json(os.path.join(d, "state.json")) or {}
        dm = st.get("done_means") or {}
        if not isinstance(dm, dict):
            dm = {}
        out.append({
            "goal": name,
            "tokens_total": st.get("tokens_total"),
            "done_means": {"done": sum(1 for v in dm.values() if v),
                           "total": len(dm)},
            "has_goal_md": os.path.exists(os.path.join(d, "GOAL.md")),
        })
    return out


def archive_detail(repo, goal_id):
    """{goal_md, state, journal:[lines]} for one archived goal, or None.
    Path-joins strictly on the basename — a goal id can never traverse out."""
    name = os.path.basename(goal_id or "")
    d = os.path.join(al_dir(repo), "archive", name)
    if not name or name in (".", "..") or not os.path.isdir(d):
        return None
    txt = read_text(os.path.join(d, "audit.jsonl"))
    journal = [ln for ln in txt.splitlines() if ln.strip()] if txt else []
    return {
        "goal": name,
        "goal_md": read_text(os.path.join(d, "GOAL.md")),
        "state": read_json(os.path.join(d, "state.json")),
        "journal": journal,
    }


# --- actions -------------------------------------------------------------------

def run_al_state(repo, args):
    """Run <bindir>/al-state --state <repo state.json> <args...> as *@al-watch."""
    cmd = [os.path.join(BIN_DIR, "al-state"),
           "--state", os.path.join(al_dir(repo), "state.json")] + args
    env = dict(os.environ)
    env["AL_ACTOR"] = "%s@al-watch" % getpass.getuser()
    try:
        proc = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=60)
        out = (proc.stdout or "") + (proc.stderr or "")
        return proc.returncode == 0, out
    except (OSError, subprocess.SubprocessError) as e:
        return False, str(e)


