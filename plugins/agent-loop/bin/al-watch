<script>
"use strict";
var ALLOW_ACTIONS = __ALLOW_ACTIONS__;
var MAX_ROWS = 1000;
var $ = function(id){ return document.getElementById(id); };
/* inert ?repo= shim — active ONLY when the fleet console drills down.
   Without the param every line below is a strict no-op. */
var REPO_PARAM = new URLSearchParams(location.search).get("repo");
function withRepo(url){
  if (!REPO_PARAM) return url;
  return url + (url.indexOf("?") >= 0 ? "&" : "?") +
         "repo=" + encodeURIComponent(REPO_PARAM);
}
if (REPO_PARAM){
  var _bk = document.createElement("a");
  _bk.id = "back-to-fleet"; _bk.className = "back-to-fleet";
  _bk.href = "/"; _bk.textContent = "◂ FLEET";
  _bk.style.cssText = "font:600 10px/1 var(--disp);letter-spacing:2px;" +
    "color:var(--aqua);text-decoration:none;border:1px solid var(--line2);" +
    "padding:6px 10px;white-space:nowrap;align-self:center";
  var _hdr = document.querySelector("header");
  if (_hdr) _hdr.insertBefore(_bk, _hdr.firstChild);
}
function esc(s){
  return String(s).replace(/[&<>"]/g, function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];
  });
}

/* ================= app state ================= */
var A = {
  snap:null, rows:[], selected:null, paused:false, buffered:[],
  filters:(localStorage.getItem("alw.filters")||"all").split(","),
  q:"", view:localStorage.getItem("alw.view")||"overview",
  live:false, replayUntil:Date.now()+1500, phase:"WAKE"
};

/* ================= view routing ================= */
function setView(v){
  A.view = v; localStorage.setItem("alw.view", v);
  document.querySelectorAll(".view").forEach(function(s){ s.classList.remove("on"); });
  document.querySelectorAll("nav button[data-view]").forEach(function(b){
    b.classList.toggle("on", b.dataset.view === v);
  });
  var el = $("view-"+v); if (el) el.classList.add("on");
  if (v === "archive") loadArchive();
}

/* ================= past loops (archive view) ================= */
function loadArchive(){
  $("archlist").style.display = "";
  $("archdetail").style.display = "none";
  fetch(withRepo("/api/archive")).then(function(r){ return r.json(); }).then(function(list){
    if (!Array.isArray(list) || !list.length){
      $("archgoals").innerHTML = "NO PAST LOOPS YET — closed goals archive here";
      $("archgoals").className = "empty";
      return;
    }
    $("archgoals").className = "";
    $("archgoals").innerHTML = "";
    list.forEach(function(g){
      var dm = g.done_means || {};
      var d = document.createElement("div");
      d.className = "task"; d.style.cursor = "pointer";
      d.innerHTML = '<b style="font-family:var(--disp);letter-spacing:1px;color:var(--aqua)">' +
        esc(g.goal) + "</b>" +
        ' <span style="color:var(--dim)">· ' +
        esc(dm.done != null ? dm.done : "?") + "/" + esc(dm.total != null ? dm.total : "?") +
        " done-means · " + esc(g.tokens_total == null ? "?" : g.tokens_total) + " tokens</span>";
      d.addEventListener("click", function(){ openArchived(g.goal); });
      $("archgoals").appendChild(d);
    });
  }).catch(function(){
    $("archgoals").textContent = "archive unavailable";
    $("archgoals").className = "empty";
  });
}
function openArchived(goal){
  var u = withRepo("/api/archive");
  u += (u.indexOf("?") >= 0 ? "&" : "?") + "goal=" + encodeURIComponent(goal);
  fetch(u).then(function(r){ return r.json(); }).then(function(d){
    $("archlist").style.display = "none";
    $("archdetail").style.display = "";
    $("archdetname").textContent = d.goal || goal;
    $("archgoalmd").innerHTML = d.goal_md ? mdlite(d.goal_md) : "—";
    var st = d.state || {}, dm = st.done_means || {};
    $("archstate").innerHTML =
      "<div>iterations recorded: <b>" + esc(st.iteration == null ? "?" : st.iteration) + "</b></div>" +
      "<div>tokens: <b>" + esc(st.tokens_total == null ? "?" : st.tokens_total) + "</b></div>" +
      '<ul style="list-style:none;margin-top:8px;padding:0">' + Object.keys(dm).map(function(k){
        return '<li><span class="tickbox ' + (dm[k] ? "on" : "off") + '">' +
               (dm[k] ? "[✓]" : "[ ]") + "</span> " + esc(k) + "</li>";
      }).join("") + "</ul>";
    var tbl = $("archjournal"); tbl.innerHTML = "";
    (d.journal || []).slice().reverse().forEach(function(line){
      var obj; try { obj = JSON.parse(line); } catch(e){ obj = { event: "raw", raw: line }; }
      var pd = (obj.payload && typeof obj.payload === "object") ? obj.payload : obj;
      var td = 'style="padding:3px 8px 3px 0;border-bottom:1px solid var(--line);vertical-align:top"';
      var tr = document.createElement("tr");
      tr.innerHTML = '<td ' + td + '><span style="color:var(--faint);font-size:10px;white-space:nowrap">' +
          esc((obj.at || "").replace(/^.*T/, "").replace("Z", "")) + "</span></td>" +
        "<td " + td + '><span class="ebadge ' + (EBADGE[obj.event] || "e-dim") + '">' +
          esc(obj.event || "?") + "</span></td>" +
        "<td " + td + ">" + summarize(obj.event || "?", pd) +
        (obj.actor ? ' <span style="color:var(--faint);font-size:10px">· ' + esc(obj.actor) + "</span>" : "") + "</td>";
      tbl.appendChild(tr);
    });
  }).catch(function(){});
}
$("archback").addEventListener("click", loadArchive);
document.querySelectorAll("nav button[data-view]").forEach(function(b){
  b.addEventListener("click", function(){ setView(b.dataset.view); });
});

/* ================= clock + favicon + title ================= */
setInterval(function(){
  var d = new Date();
  $("clock").textContent = d.toISOString().slice(11,19)+"Z";
}, 1000);
function setFavicon(color){
  var c = document.createElement("canvas"); c.width = c.height = 16;
  var g = c.getContext("2d");
  g.fillStyle = "#04070a"; g.fillRect(0,0,16,16);
  g.fillStyle = color; g.beginPath(); g.arc(8,8,4.2,0,7); g.fill();
  g.shadowColor = color; g.shadowBlur = 5; g.fill();
  $("fav").href = c.toDataURL("image/png");
}
function setAppStatus(kind, text){
  document.title = (kind==="hold" ? "◆ GATE — " : kind==="alarm" ? "● ALERT — " :
                    kind==="done" ? "✓ DONE — " : "") + "agent-loop watch";
  setFavicon(kind==="alarm" ? "#ff5468" : kind==="hold" ? "#ffb454" : "#5ff2dc");
}

/* ================= toasts ================= */
function toast(cls, head, body){
  if (!A.live) return; // no toast storm during history replay
  var t = document.createElement("div");
  t.className = "toast "+cls;
  t.innerHTML = "<b>"+esc(head)+"</b>"+esc(body||"");
  $("toasts").appendChild(t);
  setTimeout(function(){ t.style.opacity = "0"; t.style.transition = "opacity .4s"; }, 5600);
  setTimeout(function(){ t.remove(); }, 6100);
}

/* ================= phase strip ================= */
var PHASE_OF = {
  goal_init:"WAKE", lease_takeover:"WAKE", interrupted:"WAKE",
  plan_proposed:"PLAN", plan_critique:"PLAN", plan_rejected:"PLAN", plan_approved:"PLAN",
  worker_report:"ACT", tdd_red:"ACT",
  iteration:"RECORD", tick:"RECORD", memory_log:"RECORD", memory_canon:"RECORD", spec_amended:"RECORD",
  optimize:"OPTIMIZE", optimize_skipped:"OPTIMIZE", goal_closed:"OPTIMIZE"
};
var PHASE_SEQ = ["WAKE","PLAN","ACT","VERIFY","RECORD","OPTIMIZE"];
function setPhase(ph){
  if (!ph) return;
  A.phase = ph;
  var idx = PHASE_SEQ.indexOf(ph);
  document.querySelectorAll("#phases .ph").forEach(function(el, i){
    el.classList.remove("active","done","gatehold");
    if (i < idx) el.classList.add("done");
    if (i === idx) el.classList.add("active");
  });
}
function setGate(state){ // "hold" | "open" | ""
  $("gate").className = state;
  var planEl = document.querySelector('#phases .ph[data-ph="PLAN"]');
  if (state === "hold" && planEl){ planEl.classList.add("gatehold"); }
}

/* ================= overview render ================= */
function tile(k, v, cls){
  return '<div class="tile cham '+(cls||"")+'"><div class="k">'+esc(k)+'</div><div class="v">'+v+'</div></div>';
}
function stamp(txt, cls){ return '<span class="stamp '+cls+'">'+esc(txt)+'</span>'; }

function renderState(snap){
  A.snap = snap;
  var goal = snap.goal || {}, st = snap.state || {}, plan = st.plan || {};
  var lv = st.last_verdict, lease = snap.lease;
  $("goalid").textContent = goal.id || "NO ACTIVE GOAL";
  $("repoline").textContent = snap.repo || "";
  $("modechip").textContent = snap.allow_actions ? "actions armed" : "read-only";
  $("modechip").className = "chip " + (snap.allow_actions ? "amber" : "");

  var stamps = "";
  var status = goal.status || "none";
  // convergence is a first-class display state: all done-means true while the
  // goal is still "active" means the loop finished and the CLOSE-OUT is the
  // human's move (the loop never marks its own contract done)
  var dm0 = st.done_means || {}, dmk = Object.keys(dm0);
  var dmDone = dmk.filter(function(k){ return dm0[k]; }).length;
  var converged = dmk.length > 0 && dmDone === dmk.length && status === "active";
  stamps += stamp(status, status==="active" ? "aqua" : status==="done" ? "dim" : "amber");
  if (converged) stamps += stamp("CONVERGED ✓ awaiting close-out", "amber");
  if (lv) stamps += stamp(lv.pass ? "last: pass" : "last: fail", lv.pass ? "aqua" : "red");
  if (st.paused_by_stall) stamps += stamp("STALLED", "red");
  if (goal.tdd || (snap.policy && snap.policy.tdd)) stamps += stamp("tdd", "dim");
  if (goal.critic || (snap.policy && snap.policy.critic)) stamps += stamp("critic", "dim");
  if (goal.optimize !== false) stamps += stamp("optimize", "dim");
  $("goalstatus").innerHTML = stamps;

  // done-means ring + checklist
  var dm = st.done_means || {}, keys = Object.keys(dm);
  var done = keys.filter(function(k){ return dm[k]; }).length;
  var pct = keys.length ? Math.round(done/keys.length*100) : 0;
  $("ringpct").textContent = keys.length ? done+"/"+keys.length : "—";
  $("ringfg").style.strokeDashoffset = String(326.7*(1 - (keys.length ? done/keys.length : 0)));
  $("donemeans").innerHTML = keys.length ? keys.map(function(k){
    return '<li><span class="tickbox '+(dm[k]?"on":"off")+'">'+(dm[k]?"[✓]":"[ ]")+'</span>'+
           '<span class="'+(dm[k]?"done":"")+'">'+esc(k)+"</span></li>";
  }).join("") : '<li class="empty">NO DONE-MEANS</li>';

  // instrument tiles
  var iter = st.iteration == null ? "—" : st.iteration;
  var maxI = goal.max_iterations || "∞";
  var tok = st.tokens_total == null ? 0 : st.tokens_total;
  var budget = goal.budget_tokens || (snap.policy && snap.policy.budget_tokens) || 0;
  var t = "";
  t += tile("iteration", esc(iter)+' <small>/ '+esc(maxI)+"</small>", "aqua");
  t += tile("plan status", esc(plan.status||"none"),
            plan.status==="awaiting-human" ? "amber" : plan.status==="approved" ? "aqua" : "dim");
  t += tile("tokens", esc(tok.toLocaleString ? tok.toLocaleString() : tok)+
            (budget ? ' <small>/ '+esc(budget.toLocaleString())+"</small>" : ' <small>unbudgeted</small>'),
            budget && tok >= budget ? "red" : "");
  t += tile("stall count", esc(st.stall_count==null ? "—" : st.stall_count)+
            (st.paused_by_stall ? " <small>PAUSED</small>" : ""), st.paused_by_stall ? "red" : "");
  t += tile("breaker", snap.consecutive_errors >= 3 ? "OPEN" : esc(snap.consecutive_errors)+" <small>errors</small>",
            snap.consecutive_errors >= 3 ? "red" : snap.consecutive_errors > 0 ? "amber" : "dim");
  t += tile("lease", lease ? esc((lease.host||"?")+" · pid "+lease.pid) : "free", lease ? "amber" : "dim");
  $("tiles").innerHTML = t;

  // pending plan
  var actionable = plan.status === "awaiting-human";
  if (plan.status && plan.status !== "none"){
    var p = "";
    (plan.tasks||[]).forEach(function(tk){
      var task = (tk && typeof tk === "object") ? tk.task : tk;
      var kind = (tk && typeof tk === "object" && tk.kind) ? tk.kind : "";
      p += '<div class="task">'+(kind ? '<span class="kind '+esc(kind)+'">'+esc(kind)+"</span>" : "")+esc(task||"")+"</div>";
    });
    (plan.assumptions||[]).forEach(function(a){ p += '<div class="assump">? '+esc(a)+"</div>"; });
    $("plan").innerHTML = p || '<div class="empty">EMPTY PLAN</div>';
    $("plan").className = "";
  } else if (converged) {
    $("plan").innerHTML =
      '<div class="task" style="border-left-color:var(--aqua)">' +
        '<b style="color:var(--aqua);font-family:var(--disp);letter-spacing:2px">GOAL COMPLETE</b> — ' +
        'all ' + dmk.length + ' done-means verified in ' + esc(iter) + ' of ' + esc(maxI) +
        ' iterations (max_iterations is a ceiling, not a quota). Last verdict: pass.</div>' +
      '<div class="assump" style="color:var(--dim)">The loop never closes its own contract — a human ' +
        'archives it. Review the full run in TELEMETRY, then close out via /agent-loop status ' +
        '(or: set goal.json status "done", journal goal_closed, move the four files to archive/&lt;id&gt;/).</div>';
    $("plan").className = "";
  } else {
    $("plan").innerHTML = "NO PENDING PLAN";
    $("plan").className = "empty";
  }
  $("actionrow").style.display = (actionable && snap.allow_actions) ? "flex" : "none";

  // gate + alert bar + app status
  setGate(actionable ? "hold" : plan.status === "approved" ? "open" : "");
  var alertEl = $("alertbar");
  if (st.paused_by_stall || snap.consecutive_errors >= 3){
    alertEl.style.display = "flex"; alertEl.className = "red";
    $("alerttext").textContent = st.paused_by_stall
      ? "◈ STALL PAUSE — the loop is redoing identical work; a human must adjust the spec"
      : "◈ CIRCUIT BREAKER OPEN — consecutive errored ticks; re-arm required";
    $("alertapprove").style.display = "none"; $("alertreject").style.display = "none";
    setAppStatus("alarm");
  } else if (actionable){
    alertEl.style.display = "flex"; alertEl.className = "";
    $("alerttext").textContent = "◆ GATE HOLD — a proposed plan awaits human approval";
    var showBtns = snap.allow_actions;
    $("alertapprove").style.display = showBtns ? "" : "none";
    $("alertreject").style.display = showBtns ? "" : "none";
    setAppStatus("hold");
  } else if (converged){
    alertEl.style.display = "flex"; alertEl.className = "";
    $("alerttext").textContent = "✓ CONVERGED — every done-means verified; the loop is finished. Close-out is the human's move.";
    $("alertapprove").style.display = "none"; $("alertreject").style.display = "none";
    setAppStatus("done");
    // the pipeline is complete: light every phase segment steady, no pulse
    document.querySelectorAll("#phases .ph").forEach(function(el){
      el.classList.remove("active","gatehold"); el.classList.add("done");
    });
    setGate("");
  } else {
    alertEl.style.display = "none";
    setAppStatus("ok");
  }

  // contract + memory views
  $("goalmd").innerHTML = snap.goal_md ? mdlite(snap.goal_md) : "NO ACTIVE GOAL";
  $("goalmd").className = snap.goal_md ? "" : "empty";
  $("goaljson").textContent = snap.goal ? JSON.stringify(snap.goal, null, 2) : "—";
  $("policyjson").textContent = snap.policy ? JSON.stringify(snap.policy, null, 2) : "no policy file — goals govern themselves";
  $("memorymd").innerHTML = snap.memory_md ? mdlite(snap.memory_md) : "NO MEMORY FILE";
  $("memorymd").className = snap.memory_md ? "" : "empty";
}

/* tiny markdown: headings, checkboxes, bullets */
function mdlite(md){
  return md.split("\n").map(function(ln){
    var m;
    if ((m = ln.match(/^#+\s+(.*)/))) return "<h3>"+esc(m[1])+"</h3>";
    if ((m = ln.match(/^- \[([ xX])\]\s?(.*)/)))
      return '<li><span class="'+(m[1]===" "?"x-off":"x-on")+'">'+(m[1]===" "?"[ ]":"[✓]")+"</span> "+esc(m[2])+"</li>";
    if ((m = ln.match(/^[-*]\s+(.*)/))) return "<li>▪ "+esc(m[1])+"</li>";
    if (!ln.trim()) return "";
    return "<p>"+esc(ln)+"</p>";
  }).join("");
}

/* ================= telemetry feed ================= */
var GROUP_OF = {
  plan_proposed:"plan", plan_approved:"plan", plan_rejected:"plan",
  refused:"gates", tdd_red:"gates",
  worker_report:"work",
  iteration:"verdict", tick:"verdict",
  plan_critique:"mind", optimize:"mind", optimize_skipped:"mind",
  memory_log:"mind", memory_canon:"mind"
};
var EBADGE = {
  iteration:"e-aqua", tick:"e-aqua", tdd_red:"e-red", refused:"e-red",
  plan_proposed:"e-amber", plan_approved:"e-aqua", plan_rejected:"e-red",
  plan_critique:"e-violet", optimize:"e-violet", optimize_skipped:"e-dim",
  worker_report:"e-aqua", goal_init:"e-aqua", goal_closed:"e-dim",
  stall_pause:"e-red", lease_takeover:"e-amber", memory_log:"e-dim",
  memory_canon:"e-violet", spec_amended:"e-amber", interrupted:"e-amber"
};
function groupOf(ev){ return GROUP_OF[ev] || "sys"; }

function summarize(ev, d){
  switch (ev){
    case "iteration": {
      var v = d.verdict, pass = v && typeof v === "object" ? v.pass : v;
      return "iter "+(d.iter!=null?d.iter:"?")+" — "+
        (pass===true ? '<span style="color:var(--aqua)">PASS</span>'
         : pass===false ? '<span style="color:var(--red)">FAIL</span>' : "recorded")+
        (d.stall_count ? ' <span style="color:var(--amber)">(stall '+esc(d.stall_count)+")</span>" : "");
    }
    case "tdd_red":       return "red observed · rc="+esc(d.rc)+" · <code>"+esc(d.cmd||"?")+"</code>";
    case "refused":       return '<span style="color:var(--red)">'+esc(d.op||"op")+" REFUSED</span> — "+esc(d.reason||"");
    case "plan_critique": return "critic verdict: <b>"+esc(d.verdict||"?")+"</b>"+
                                 (d.model ? ' <span style="color:var(--dim)">via '+esc(d.model)+"</span>" : "")+
                                 ((d.blockers||[]).length ? ' · <span style="color:var(--red)">'+d.blockers.length+" blocker(s)</span>" : "");
    case "tick":          return "done-means ticked → <b>"+esc(d.slug||"?")+"</b>";
    case "optimize":      return "optimize · +"+esc(d.guidance_appended||0)+" guidance · +"+
                                 esc(d.canon_appended||0)+" canon"+
                                 (d.guidance_truncated ? " · "+esc(d.guidance_truncated)+" truncated" : "");
    case "optimize_skipped": return "optimize skipped — "+esc(d.reason||"");
    case "worker_report": return "worker · "+esc((d.task||d.report||"").toString().slice(0,140));
    case "plan_proposed": return "plan proposed · "+esc((d.tasks||[]).length)+" task(s) → "+esc(d.status||"?");
    case "plan_approved": return "plan APPROVED by "+esc(d.by||"?");
    case "plan_rejected": return "plan rejected — "+esc(d.reason||"");
    case "goal_init":     return "goal initialized · "+esc(Object.keys(d.done_means||{}).length)+" done-means";
    case "goal_closed":   return "goal closed — "+esc(d.reason||"");
    case "stall_pause":   return '<span style="color:var(--red)">STALL:</span> '+esc((d.report||"").slice(0,160));
    case "lease_takeover":return "stale lease taken over";
    case "spec_amended":  return "spec amended — "+esc((d.added||"").slice(0,140));
    case "interrupted":   return "prior session died mid-iteration · "+esc(d.dirty_files||0)+" dirty file(s)";
    default: { var s = JSON.stringify(d); return s && s !== "{}" ? esc(s.slice(0,160)) : ""; }
  }
}

function rowMatches(r){
  if (A.filters.indexOf("all") < 0 && A.filters.indexOf(groupOf(r.ev)) < 0) return false;
  if (A.q && r.line.toLowerCase().indexOf(A.q) < 0) return false;
  return true;
}
function makeRowEl(r, fresh){
  var div = document.createElement("div");
  div.className = "row" + (fresh ? " fresh" : "");
  div.innerHTML = '<span class="at">'+esc((r.obj.at||"").replace(/^.*T/,"").replace("Z",""))+"</span>"+
    '<span class="ebadge '+(EBADGE[r.ev]||"e-dim")+'">'+esc(r.ev)+"</span>"+
    '<span class="sum">'+summarize(r.ev, r.d)+"</span>"+
    (r.obj.actor ? '<span class="actor">'+esc(r.obj.actor)+"</span>" : "");
  div.addEventListener("click", function(){ inspect(r, div); });
  return div;
}
function refreshFeed(){
  var feed = $("feed");
  feed.innerHTML = "";
  var shown = 0;
  for (var i = A.rows.length - 1; i >= 0; i--){   // newest first
    var r = A.rows[i];
    if (!rowMatches(r)) continue;
    feed.appendChild(makeRowEl(r, false));
    shown++;
  }
  $("feedcount").textContent = shown + " / " + A.rows.length + " events";
  if (!shown) feed.innerHTML = '<div class="empty">NO MATCHING TELEMETRY</div>';
}
function ingest(line, liveFresh){
  var obj;
  try { obj = JSON.parse(line); } catch(e){ obj = { event:"raw", raw:line }; }
  var d = (obj.payload && typeof obj.payload === "object") ? obj.payload : obj;
  var r = { line:line.toLowerCase(), obj:obj, d:d, ev:obj.event || "?" };
  A.rows.push(r);
  if (A.rows.length > MAX_ROWS) A.rows.shift();
  if (rowMatches(r)){
    var feed = $("feed");
    if (feed.firstChild && feed.firstChild.className === "empty") feed.innerHTML = "";
    feed.insertBefore(makeRowEl(r, liveFresh), feed.firstChild);
    while (feed.children.length > MAX_ROWS) feed.removeChild(feed.lastChild);
  }
  $("feedcount").textContent = document.querySelectorAll("#feed .row").length + " / " + A.rows.length + " events";
  // phase strip + notifications
  if (PHASE_OF[r.ev]) setPhase(PHASE_OF[r.ev]);
  if (liveFresh){
    if (r.ev === "refused") toast("red", "GATE REFUSAL", d.op + " — " + (d.reason||""));
    else if (r.ev === "stall_pause") toast("red", "STALL PAUSE", (d.report||"").slice(0,120));
    else if (r.ev === "plan_proposed" && d.status === "awaiting-human")
      toast("amber", "GATE HOLD", "a plan awaits human approval");
    else if (r.ev === "plan_approved") toast("aqua", "PLAN APPROVED", "by " + (d.by||"?"));
    else if (r.ev === "tdd_red") toast("aqua", "RED OBSERVED", d.cmd||"");
    else if (r.ev === "goal_closed") toast("aqua", "GOAL CLOSED", d.reason||"");
  }
}

/* ---------- inspector drawer ---------- */
function jsonColor(obj){
  var s = esc(JSON.stringify(obj, null, 2));
  return s.replace(/(&quot;[^&]*?&quot;)(\s*:)?/g, function(m, str, colon){
      return colon ? '<span class="jkey">'+str+"</span>"+colon : '<span class="jstr">'+str+"</span>";
    })
    .replace(/\b(true|false|null)\b/g, '<span class="jlit">$1</span>')
    .replace(/(:\s*)(-?\d[\d.]*)/g, '$1<span class="jnum">$2</span>');
}
function inspect(r, el){
  document.querySelectorAll("#feed .row.sel").forEach(function(x){ x.classList.remove("sel"); });
  if (el) el.classList.add("sel");
  $("inspbadge").textContent = r.ev;
  $("inspbadge").className = "ebadge " + (EBADGE[r.ev] || "e-dim");
  $("inspmeta").innerHTML = "at " + esc(r.obj.at||"?") +
    (r.obj.actor ? " · actor <b>"+esc(r.obj.actor)+"</b>" : "") +
    (r.obj.prev ? "<br>chain ← " + esc(String(r.obj.prev).slice(0,18)) + "…" : "");
  $("inspjson").innerHTML = jsonColor(r.obj);
  $("inspector").classList.add("open");
}
$("inspclose").addEventListener("click", function(){
  $("inspector").classList.remove("open");
  document.querySelectorAll("#feed .row.sel").forEach(function(x){ x.classList.remove("sel"); });
});

/* ---------- filters / search / pause ---------- */
document.querySelectorAll(".fchip").forEach(function(ch){
  ch.addEventListener("click", function(){
    var g = ch.dataset.g;
    if (g === "all"){ A.filters = ["all"]; }
    else {
      A.filters = A.filters.filter(function(x){ return x !== "all"; });
      var i = A.filters.indexOf(g);
      if (i >= 0) A.filters.splice(i, 1); else A.filters.push(g);
      if (!A.filters.length) A.filters = ["all"];
    }
    localStorage.setItem("alw.filters", A.filters.join(","));
    document.querySelectorAll(".fchip").forEach(function(c){
      c.classList.toggle("on", A.filters.indexOf(c.dataset.g) >= 0);
    });
    refreshFeed();
  });
});
document.querySelectorAll(".fchip").forEach(function(c){
  c.classList.toggle("on", A.filters.indexOf(c.dataset.g) >= 0);
});
$("q").addEventListener("input", function(){ A.q = $("q").value.toLowerCase(); refreshFeed(); });
$("pausebtn").addEventListener("click", function(){
  A.paused = !A.paused;
  $("pausebtn").textContent = A.paused ? "Resume ("+A.buffered.length+")" : "Pause";
  $("pausebtn").className = "cta" + (A.paused ? " amber" : "");
  if (!A.paused){
    A.buffered.forEach(function(l){ ingest(l, false); });
    A.buffered = [];
    refreshFeed();
  }
});

/* ---------- keyboard ---------- */
