});
$("approve").addEventListener("click", function(){ openModal("approve"); });
$("reject").addEventListener("click", function(){ openModal("reject"); });
$("alertapprove").addEventListener("click", function(){ openModal("approve"); });
$("alertreject").addEventListener("click", function(){ openModal("reject"); });

/* ---------- live stream ---------- */
setAppStatus("ok");
setPhase("WAKE");
var es = new EventSource(withRepo("/events"));
es.addEventListener("journal", function(e){
  var live = Date.now() > A.replayUntil;
  if (!live) A.replayUntil = Date.now() + 400;  // extend while replay burst continues
