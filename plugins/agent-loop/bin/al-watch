es.addEventListener("state", function(e){
  try { renderState(JSON.parse(e.data)); } catch(err){}
});
es.onopen = function(){
  $("conn").innerHTML = '<span class="led aqua"></span>LIVE';
};
es.onerror = function(){
  $("conn").innerHTML = '<span class="led red"></span>RELINK';
};

setView(A.view);
fetch(withRepo("/api/state")).then(function(r){ return r.json(); }).then(renderState).catch(function(){});
</script>
</body>
</html>
"""


# --- HTTP handler ----------------------------------------------------------------

def make_handler(repo, allow_actions):
    audit_path = os.path.join(al_dir(repo), "audit.jsonl")

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *args):
            if not QUIET:
                BaseHTTPRequestHandler.log_message(self, fmt, *args)

        # -- helpers -------------------------------------------------------------
        def send_json(self, code, obj):
            body = json.dumps(obj).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def read_body_json(self):
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                length = 0
            if length <= 0:
                return {}
            try:
                return json.loads(self.rfile.read(length).decode("utf-8", "replace"))
            except ValueError:
                return {}

        # -- GET ----------------------------------------------------------------
        def do_GET(self):
            path = self.path.split("?", 1)[0]
            if path == "/":
                body = DASHBOARD_HTML.replace(
                    "__ALLOW_ACTIONS__", json.dumps(allow_actions)).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            elif path == "/api/state":
                self.send_json(200, snapshot(repo, allow_actions))
            elif path == "/api/archive":
                # past loops: closed goals archived by close-out stay browsable
                q = parse_qs(urlsplit(self.path).query)
                goal = (q.get("goal") or [None])[0]
                if goal:
                    detail = archive_detail(repo, goal)
                    if detail is None:
                        self.send_json(404, {"error": "no such archived goal"})
                    else:
                        self.send_json(200, detail)
                else:
                    self.send_json(200, archive_list(repo))
            elif path == "/events":
                self.serve_events()
            else:
                self.send_json(404, {"error": "not found"})

        # -- SSE ----------------------------------------------------------------
        def sse(self, event, data):
            chunk = ""
            if event:
                chunk += "event: %s\n" % event
            for line in data.split("\n"):
                chunk += "data: %s\n" % line
            chunk += "\n"
            self.wfile.write(chunk.encode("utf-8"))
            self.wfile.flush()

        def serve_events(self):
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "close")
            self.end_headers()
            try:
                offset = self.replay_journal()
                last_snap = None
                last_hb = time.time()
                buf = b""
                while True:
                    # journal follow by byte offset; shrink (goal archived) resets
                    try:
                        size = os.path.getsize(audit_path)
                    except OSError:
                        size = 0
                    if size < offset:
                        offset, buf = 0, b""
                    if size > offset:
                        with open(audit_path, "rb") as f:
                            f.seek(offset)
                            buf += f.read(size - offset)
                        offset = size
                        while b"\n" in buf:
                            line, buf = buf.split(b"\n", 1)
                            line = line.decode("utf-8", "replace").rstrip("\r")
                            if line.strip():
                                self.sse("journal", line)
                    # state push on change
                    snap = json.dumps(snapshot(repo, allow_actions), sort_keys=True)
                    if snap != last_snap:
                        last_snap = snap
                        self.sse("state", snap)
                    # heartbeat comment ~15s
                    now = time.time()
                    if now - last_hb >= HEARTBEAT_SECS:
                        last_hb = now
                        self.wfile.write(b": heartbeat\n\n")
                        self.wfile.flush()
                    time.sleep(POLL_SECS)
            except (BrokenPipeError, ConnectionResetError):
                pass  # client went away — normal for a dashboard tab closing

        def replay_journal(self):
            """Emit every existing audit.jsonl line VERBATIM; return byte offset."""
            try:
                with open(audit_path, "rb") as f:
                    raw = f.read()
            except OSError:
                return 0
            offset = len(raw)
            if raw and not raw.endswith(b"\n"):  # hold a partial trailing line
                cut = raw.rfind(b"\n") + 1
                raw, offset = raw[:cut], cut
            for bline in raw.split(b"\n"):
                line = bline.decode("utf-8", "replace").rstrip("\r")
                if line.strip():
                    self.sse("journal", line)
            return offset

        # -- POST ----------------------------------------------------------------
        def do_POST(self):
            # one CSRF rule, both modes: JSON Content-Type + a local Host header
            ctype = self.headers.get("Content-Type") or ""
            if "application/json" not in ctype:
                self.send_json(415, {"error": "Content-Type must be application/json"})
                return
            host = (self.headers.get("Host") or "").partition(":")[0]
            if host not in ("127.0.0.1", "localhost"):
                self.send_json(403, {"error": "requests must address 127.0.0.1 or localhost"})
                return
            path = self.path.split("?", 1)[0]
            if path not in ("/api/approve", "/api/reject"):
                self.send_json(404, {"error": "not found"})
                return
            if not allow_actions:
                self.send_json(403, {"error": "actions disabled — restart al-watch with --allow-actions"})
                return
            body = self.read_body_json()
            if path == "/api/approve":
                ok, out = run_al_state(repo, ["plan-approve"])
            else:
                reason = body.get("reason")
                if not isinstance(reason, str) or not reason.strip():
                    self.send_json(400, {"error": "reject requires a non-empty \"reason\" in the JSON body"})
                    return
                ok, out = run_al_state(repo, ["plan-reject", reason])
            self.send_json(200 if ok else 500, {"ok": ok, "output": out})

    return Handler


# --- fleet HTTP handler ------------------------------------------------------------

