  if (e.key === "1") setView("overview");
  else if (e.key === "2") setView("telemetry");
  else if (e.key === "3") setView("contract");
  else if (e.key === "4") setView("memory");
  else if (e.key === "5") setView("archive");
  else if (e.key === "/"){ e.preventDefault(); setView("telemetry"); $("q").focus(); }
  else if (e.key === "p"){ $("pausebtn").click(); }
});

/* ---------- actions: modal ---------- */
var MODAL = { kind:null };
function openModal(kind){
